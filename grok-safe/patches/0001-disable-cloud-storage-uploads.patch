+const GROK_SAFE_UNSAFE_ALLOW_STORAGE_UPLOADS: &str =
+    "GROK_SAFE_UNSAFE_ALLOW_STORAGE_UPLOADS";
+
+fn grok_safe_storage_uploads_allowed() -> bool {
+    matches!(
+        std::env::var(GROK_SAFE_UNSAFE_ALLOW_STORAGE_UPLOADS).as_deref(),
+        Ok("1") | Ok("true") | Ok("TRUE") | Ok("yes") | Ok("YES")
+    )
+}
+
+fn grok_safe_block_cloud_storage_upload(operation: &str) -> anyhow::Result<()> {
+    if grok_safe_storage_uploads_allowed() {
+        return Ok(());
+    }
+
+    anyhow::bail!(
+        "grok-safe: blocked cloud-storage upload attempt ({operation}); \
+         GROK_SAFE_UNSAFE_ALLOW_STORAGE_UPLOADS=1 is required to re-enable upstream upload behavior"
+    )
+}
