@@ -10,6 +10,25 @@ use anyhow::{Context, Result};
 use reqwest::RequestBuilder;
 use serde::{Deserialize, Serialize};
 
+const GROK_SAFE_UNSAFE_ALLOW_REMOTE_SYNC: &str =
+    "GROK_SAFE_UNSAFE_ALLOW_REMOTE_SYNC";
+
+fn grok_safe_remote_sync_allowed() -> bool {
+    cfg!(test)
+        || matches!(
+            std::env::var(GROK_SAFE_UNSAFE_ALLOW_REMOTE_SYNC).as_deref(),
+            Ok("1") | Ok("true") | Ok("TRUE") | Ok("yes") | Ok("YES")
+        )
+}
+
+fn grok_safe_block_session_registry_write(op: &str) -> Result<()> {
+    if grok_safe_remote_sync_allowed() {
+        return Ok(());
+    }
+    anyhow::bail!("grok-safe: blocked session-registry remote replication request ({op})")
+}
+
