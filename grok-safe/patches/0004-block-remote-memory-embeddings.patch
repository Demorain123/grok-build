diff --git a/crates/codegen/xai-grok-memory/src/embedding.rs b/crates/codegen/xai-grok-memory/src/embedding.rs
--- a/crates/codegen/xai-grok-memory/src/embedding.rs
+++ b/crates/codegen/xai-grok-memory/src/embedding.rs
@@ -15,6 +15,17 @@ const MAX_RETRIES: usize = 3;
 /// Initial backoff delay in milliseconds (doubles on each retry: 1s, 2s, 4s).
 const INITIAL_BACKOFF_MS: u64 = 1000;
 
+const GROK_SAFE_UNSAFE_ALLOW_AUX_EGRESS: &str =
+    "GROK_SAFE_UNSAFE_ALLOW_AUX_EGRESS";
+
+fn grok_safe_aux_egress_allowed() -> bool {
+    cfg!(test)
+        || matches!(
+            std::env::var(GROK_SAFE_UNSAFE_ALLOW_AUX_EGRESS).as_deref(),
+            Ok("1") | Ok("true") | Ok("TRUE") | Ok("yes") | Ok("YES")
+        )
+}
+
 /// Trait for generating text embeddings.
 ///
 /// Implementations must be `Send + Sync` so they can be used in `Send`
@@ -63,6 +74,12 @@ impl ApiEmbeddingProvider {
         config: &xai_grok_config_types::MemoryEmbeddingConfig,
         api_base: String,
         client: reqwest_middleware::ClientWithMiddleware,
     ) -> Option<Self> {
+        if !grok_safe_aux_egress_allowed() {
+            // grok-safe: blocked remote memory embedding text egress by declining
+            // provider construction; callers naturally keep FTS-only memory search.
+            return None;
+        }
+
         let model = config.model.clone().filter(|m| !m.is_empty())?;
         Some(Self::new(api_base, model, config.dimensions, client))
     }
